# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Dart, HTML, CSS, JS, JSON, YAML
*.dart text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.webp binary
